DATA_SOURCE=local
DATA_DIR=.data
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=
DONATION_NOTIFY_EMAIL=
EMAIL_FROM=
RATE_LIMIT_SALT=
BANK_BIN=
BANK_NAME=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
MONGODB_URI=
MONGODB_DB=refolks
# Google sign-in (Google Cloud Console > OAuth client "Web application").
# Redirect URI to register: <origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail SMTP for email codes and order mail (Node only; the Worker uses Resend).
# Needs 2-Step Verification + a 16-character App Password. Unset = Resend, if configured.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Sample-account password for scripts/mongo-seed.mjs (12+ chars; never commit).
SEED_PASSWORD=

# Canonical origin for SEO (sitemap, canonical, JSON-LD), e.g. https://refolks.store.
# On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_ORIGIN=
